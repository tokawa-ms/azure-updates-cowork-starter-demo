<mxCell id="C1" value="&lt;b&gt;End the thread&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;New chat or tab close&lt;br&gt;POST /api/threads/end&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=36;imageHeight=36;spacing=2;image=data:image/svg+xml,;imageAlign=center;imageVerticalAlign=top;align=center;verticalAlign=top;spacingTop=46;spacingLeft=6;spacingRight=6;" vertex="1" parent="gC"><mxGeometry x="20" y="36" width="200" height="118" as="geometry" /></mxCell>
