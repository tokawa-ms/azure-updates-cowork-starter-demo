<mxCell id="local" value="&lt;b&gt;Local: Aspire Dashboard&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Web and agent send OTLP (:4317)&lt;br&gt;View the tree at http://localhost:18888&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=data:image/svg+xml,;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="104" width="430" height="100" as="geometry" /></mxCell>
<mxCell id="appi" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Web uses the Azure Monitor exporter;&lt;br&gt;the Hosted Agent gets the connection string&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=img/lib/azure2/devops/Application_Insights.svg;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="216" width="430" height="100" as="geometry" /></mxCell>
<mxCell id="portal" value="&lt;b&gt;Foundry portal&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Traces and Monitor show tokens,&lt;br&gt;latency and success rate&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=img/lib/azure2/ai_machine_learning/AI_Foundry.svg;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="328" width="430" height="100" as="geometry" /></mxCell>
<mxCell id="kql" value="&lt;b&gt;Logs (KQL), optional alerts&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Filter by operation_Id. Alerts: tool failures&lt;br&gt;above 20%, chat.turn p95 above 120 s&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="440" width="430" height="100" as="geometry" /></mxCell>
<mxCell id="content" value="&lt;b&gt;Message content&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Own agent: false in production, true only&lt;br&gt;for the fixed-data evaluation. The Foundry&lt;br&gt;responsesapi still records message text,&lt;br&gt;so never enter confidential data&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FDF0E6;strokeColor=#C55A11;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=data:image/svg+xml,;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="552" width="430" height="148" as="geometry" /></mxCell>
