<mxCell id="local" value="&lt;b&gt;ローカル: Aspire Dashboard&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Web と Agent が OTLP (:4317) で送る&lt;br&gt;http://localhost:18888 で親子関係を見る&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=data:image/svg+xml,;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="104" width="430" height="100" as="geometry" /></mxCell>
<mxCell id="appi" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Web は Azure Monitor エクスポーター、&lt;br&gt;Hosted Agent は接続文字列が自動で入る&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=img/lib/azure2/devops/Application_Insights.svg;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="216" width="430" height="100" as="geometry" /></mxCell>
<mxCell id="portal" value="&lt;b&gt;Foundry ポータル&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Traces と Monitor で、トークン数・遅延・&lt;br&gt;成功率を確認する&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=img/lib/azure2/ai_machine_learning/AI_Foundry.svg;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="328" width="430" height="100" as="geometry" /></mxCell>
<mxCell id="kql" value="&lt;b&gt;Logs (KQL)・アラート (任意)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;operation_Id で絞り込む。ツール失敗率 20% 超、&lt;br&gt;chat.turn の p95 が 120 秒超で通知&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="440" width="430" height="100" as="geometry" /></mxCell>
<mxCell id="content" value="&lt;b&gt;本文の記録&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;自作 Agent の本文記録は本番 false、&lt;br&gt;固定データ評価だけ true。&lt;br&gt;Foundry の responsesapi 側は本文を&lt;br&gt;記録するため、機密情報は入力しない&lt;/font&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FDF0E6;strokeColor=#C55A11;strokeWidth=1.5;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;imageWidth=40;imageHeight=40;spacing=2;image=data:image/svg+xml,;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="810" y="552" width="430" height="148" as="geometry" /></mxCell>
</root>
