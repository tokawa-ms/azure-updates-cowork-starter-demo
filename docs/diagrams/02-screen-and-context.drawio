<mxCell id="st_b4" value="4" style="ellipse;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="800" y="394" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="st_t4" value="&lt;b&gt;Send a request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;POST /api/chat with the request and pageContext, never the article text&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="396" width="412" height="82" as="geometry" /></mxCell>
<mxCell id="st_b5" value="5" style="ellipse;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="800" y="488" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="st_t5" value="&lt;b&gt;Hand over to the agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The BFF re-validates pageContext and sends it as a developer message&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="490" width="412" height="82" as="geometry" /></mxCell>
<mxCell id="st_b6" value="6" style="ellipse;html=1;fillColor=#0F766E;strokeColor=#FFFFFF;strokeWidth=2;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;resizable=0;" vertex="1" parent="1"><mxGeometry x="800" y="582" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="st_t6" value="&lt;b&gt;Fetch the article&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The agent calls get_azure_update and treats the text as untrusted data&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Meiryo UI;fontSize=16;fontColor=#1B1B1B;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="584" width="412" height="82" as="geometry" /></mxCell>
