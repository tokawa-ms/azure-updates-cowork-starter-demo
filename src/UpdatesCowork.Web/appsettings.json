{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "Mode": "Foundry",
    "BaseUrl": "",
    "ApiVersion": "v1",
    "ConversationMode": "Conversations",
    "SendUserIdentity": false,
    "VersionOverride": "",
    "TurnTimeoutSeconds": 200,
    "RecordTo": ""
  },
  "Artifacts": {
    "Mode": "SessionFiles",
    "LocalDir": ""
  },
  "Web": {
    "Features": {
      "Approvals": false,
      "LearningMode": true
    }
  },
  "Auth": {
    "Mode": "Anonymous"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  }
}
